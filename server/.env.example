# Ardson Maritime API — environment template
# Copy to server/.env (never commit the real file) and load it with your
# process manager, e.g. `node --env-file=.env server.js` or PM2/systemd.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Set to false when the static frontend is served by Vercel/Netlify.
SERVE_STATIC=true
# Number of reverse-proxy hops in front of the API (1 for nginx/Caddy/ALB).
# Leave unset when clients connect directly.
# TRUST_PROXY=1

# --- Admin authentication (required in production) -------------------------
ADMIN_USER=admin@ardsonmaritime.com
ADMIN_PASSWORD=replace-with-a-long-random-password
# Comma-separated machine tokens for integrations. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKENS=replace-with-a-random-token

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=https://www.ardsonmaritime.com,https://ardsonmaritime.com

# --- Uploads / documents ---------------------------------------------------
# 64 hex characters (32 bytes) for AES-256-GCM CV encryption at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CV_ENCRYPTION_KEY=
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# VIRUS_SCAN_STRICT=true
# FFMPEG_PATH=/usr/bin/ffmpeg

# --- Notifications ---------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@ardsonmaritime.com
# NOTIFY_EMAIL_TO=ardsonmaritime@outlook.com
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TO=
# Set to true only when debugging locally: dry-run notifications will
# print their full contents (including personal data) to stdout.
# NOTIFIER_DEBUG=false
